{
  "name": "front-office",
  "main": "dist/server/entry-server.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../../../dist/static",
    "binding": "ASSETS",
    "html_handling": "none",
    "headers": {
      "/assets/*": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  },
  "services": [
    {
      "binding": "FRAGMENT_FOOTER",
      "service": "fragment-footer"
    },
    {
      "binding": "FRAGMENT_HEADER",
      "service": "fragment-header"
    },
    {
      "binding": "FRAGMENT_PRODUCT",
      "service": "fragment-product"
    }
  ]
}
