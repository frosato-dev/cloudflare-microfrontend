{
  "name": "meta-framework-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev-server.ts",
    "build": "pnpm -r run build",
    "preview": "pnpm run build && framework-cli preview",
    "preview:front-office": "pnpm run build && framework-cli preview --app front-office",
    "preview:back-office": "pnpm run build && framework-cli preview --app back-office",
    "test": "vitest run",
    "deploy": "pnpm run build && framework-cli deploy"
  },
  "devDependencies": {
    "framework": "link:../framework",
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^5.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.78.0"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "volta": {
    "node": "22.22.2",
    "pnpm": "10.17.0"
  }
}
