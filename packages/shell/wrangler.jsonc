{
  "name": "meta-framework-shell",
  "main": "dist/server/entry-server.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist/static",
    "binding": "ASSETS"
  },
  // Service bindings to fragment workers
  "services": [
    { "binding": "FRAGMENT_HEADER", "service": "meta-framework-fragment-header" },
    { "binding": "FRAGMENT_PRODUCT", "service": "meta-framework-fragment-product" }
  ]
}
